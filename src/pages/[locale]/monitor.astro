---
import PublicMonitor from '../../components/PublicMonitor';
import Layout from '../../layouts/Layout.astro';
import { localeStaticPaths } from '../../domain/locales';
import type { Locale } from '../../domain/types';
import '../../styles/admin.css';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const titles: Record<Locale, string> = {
  en: 'Address Data Monitor', 'zh-CN': '地址数据监控', 'zh-TW': '地址資料監控', ja: '住所データ監視', ko: '주소 데이터 모니터',
  de: 'Adressdatenmonitor', fr: "Suivi des données d'adresse", es: 'Monitor de datos de direcciones', pt: 'Monitor de dados de endereços'
};
---
<Layout locale={locale} pagePath="monitor" title={titles[locale]}>
  {/* Start the figures and the world map before the bundle arrives; the components adopt these responses. */}
  <script slot="head" is:inline>
    try {
      // The body is read here, inside the timeout; a response adopted later must not depend on the expired signal.
      const start = (url) => { const request = fetch(url, { headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(15000) })
        .then(async (response) => new Response([204, 304].includes(response.status) ? null : await response.arrayBuffer(), { status: response.status, headers: response.headers })); request.catch(() => {}); return request; };
      window.__monitorBoot = { data: start('/web-api/v1/public-monitor'), map: start('/maps/world-map-units.geojson') };
    } catch { /* The components fall back to their own requests. */ }
  </script>
  <PublicMonitor client:load locale={locale} />
</Layout>
